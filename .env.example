# Groq API (required — powers the AI plan-generation)
GROQ_API_KEY=

# AWS (defaults to us-east-1 if unset)
AWS_REGION=us-east-1

# Azure — currently required at startup regardless of mode (AzureTool raises
# if AZURE_SUBSCRIPTION_ID is unset, even for local-only/AWS-only use).
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# Email alerting (optional)
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
